<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A single TFM is enough for the test project; the three-TFM proof is the library build. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions as generated by `dotnet new xunit -f net8.0` on this machine. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!--
      Supplies [StaFact] and [StaTheory]. The hand-rolled alternative (a custom XunitTestCase
      plus a runner/invoker pair) was written first, but plain [Fact] carries no discovery hook
      in xunit v2, so the bodies kept running on an MTA thread and the harness silently did
      nothing. The supported extension point is [XunitTestCaseDiscoverer], and this package is
      the battle-tested implementation of exactly that. Test-graph only: the shipped library
      stays dependency-free (R011, D001).
    -->
    <PackageReference Include="Xunit.StaFact" Version="1.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Trustsoft.NotifyIcon/Trustsoft.NotifyIcon.csproj" />
  </ItemGroup>

  <!--
    No FluentAssertions and no other assertion library (D009): FluentAssertions v8 is
    commercially licensed and unacceptable in the test graph of a public MIT package.
    Plain xunit asserts only.
  -->

</Project>
