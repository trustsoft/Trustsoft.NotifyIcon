<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A single TFM is enough for the live proof: the three-TFM contract belongs to the library
      (net8.0-windows;net9.0-windows;net10.0-windows) and the sample only has to be a real WPF
      application that shows the icon.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Trustsoft.NotifyIcon.Sample</AssemblyName>
    <RootNamespace>Trustsoft.NotifyIcon.Sample</RootNamespace>
    <!--
      A demonstration app, never a package. Without this, `dotnet pack Trustsoft.NotifyIcon.sln`
      would try to produce a sample nupkg next to the library.
    -->
    <IsPackable>false</IsPackable>
    <!--
      Per-monitor DPI awareness for the sample (S03/T06). This is an EXECUTABLE-LEVEL setting and
      for PerMonitorV2 it is MANIFEST-ONLY: there is no <dpiAware> element equivalent, and the
      programmatic API (SetProcessDpiAwarenessContext) must run before the process owns its first
      window handle - something a WPF library can never guarantee, because the consumer's own
      startup and WPF's own window creation run first. The library therefore never touches process
      DPI awareness by design (D026) and reads the icon's monitor with GetDpiForMonitor instead.
      A consumer copying this sample's setup should copy app.manifest and this line with it. See
      the header comment inside app.manifest for what a missing or stale manifest looks like.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Trustsoft.NotifyIcon/Trustsoft.NotifyIcon.csproj" />
  </ItemGroup>

  <!--
    No PackageReference entries, on purpose (R011, D001): this sample is the counterexample-free
    demonstration that a real tray icon needs no System.Windows.Forms, no System.Drawing.Common and
    no tray-helper package. Everything it needs beyond WPF comes from the library under test.
  -->

</Project>
