<Application x:Class="Trustsoft.NotifyIcon.Sample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Trustsoft.NotifyIcon.Sample"
             ShutdownMode="OnExplicitShutdown">
    <!--
      No StartupUri on purpose: the premise of this project is an application that owns a tray icon
      and NO window (R001). The application therefore never shuts down by itself - OnExplicitShutdown
      plus the Exit/SessionEnding handlers in App.xaml.cs are what end the process.
    -->

    <!--
      S06: the declarative declaration, and the reference consumer pattern for R008/R009.

      It is declared unconditionally but inert for code-first runs, because BAML defers value
      creation until the first lookup (App.xaml.cs only looks the icon up when the declarative switch is
      given), so a code-first run never instantiates anything here and never ends up with a second
      icon. That claim is cross-checked live in docs/UAT-S06.md rather than assumed.

      Document order matters: StaticResource resolves against what has already been declared, so the
      image and the menu come before the icon that references them.

      The handlers named by the event attributes are the App methods the code-first mode subscribes
      in C#, which is deliberate - the two modes must reach the same behaviour through the same
      handlers, so the markup compiler validates the same signatures a consumer would write. A
      misspelled handler or a wrong argument type fails the build here rather than at runtime.
    -->
    <Application.Resources>
        <!--
          The image is a markup DrawingImage rather than a file on disk: the declaration then needs no
          binary asset, and S01 already proved a vector source converts (and stays correctly sized
          under a raised Display Scale).
        -->
        <DrawingImage x:Key="TrayImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF3060A0">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7" />
                            <RectangleGeometry Rect="7,3 2,10" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!--
          T06: the menu's own DataContext, as an application-level resource object. It is the source a
          bound item resolves against, and it has to be set by the consumer of this library: a menu
          declared here has no logical parent, and the library points the menu's PlacementTarget at its
          own 1x1 anchor window rather than at the icon, so the icon's DataContext never reaches the
          menu. The library never writes a menu's DataContext either - see SampleMenuData, the
          headless pin in TrayIconMenuDataContextTests, and docs/UAT-S06.md, "Menu data context and
          bindings (T06)".

          Declared before the menu because StaticResource resolves in document order.
        -->
        <local:SampleMenuData x:Key="TrayMenuData" Label="declared menu data context" />

        <!--
          The menu, with each kind of attribute expressed in markup: an item's Click, the popup's own
          Opened/Closed, and a header bound against the menu's own DataContext. The first item writes a
          line when chosen, so the item-click path is observable on the same console as the open and
          dismiss lines; the second item renders whatever {Binding Label} resolves to, which the
          "menu data context:" line reports on every open - a binding that resolves to nothing prints
          as an empty header rather than passing silently.
        -->
        <ContextMenu x:Key="TrayMenu"
                     DataContext="{StaticResource TrayMenuData}"
                     Opened="OnMenuOpened"
                     Closed="OnMenuClosed">
            <MenuItem Header="Sample menu item" Click="OnDeclaredMenuItemClick" />
            <MenuItem Header="{Binding Label}" />
        </ContextMenu>

        <!--
          The icon itself. Visible="True" is what registers it, and the markup carries the tooltip,
          the menu activation policy, the image and every event. No balloon property exists anywhere
          (D031): a balloon stays a method call, so the sample demonstrates one through its balloon
          self-show timer in this mode too.

          The declared element is the sample's own SampleTrayIcon, not the library's TrayIcon, for one
          reason: the self-open menu switch has to open the *declared* menu with no shell click, and that
          path needs the protected OnTrayClick hook the subclass exposes. Every attribute used here belongs
          to the library type and resolves through the same dependency properties and routed events, so
          the declaration is still the library's markup surface; TrayIconXamlContractTests pins that the
          library type itself parses for a consumer, and the UAT records the same run in code-first mode.

          The namespace is deliberately NOT assembly-qualified. A clr-namespace with
          ";assembly=Trustsoft.NotifyIcon.Sample" fails the markup compiler with MC3074 for a type in the
          ApplicationDefinition's own project, because that assembly does not exist yet while it is being
          compiled; omitting the qualifier resolves the local type, which is why xmlns:local carries no
          assembly name.

          A consumer's ApplicationDefinition lives in another assembly, so it writes the library's own
          namespace instead - http://schemas.trustsoft.com/notifyicon, declared with XmlnsPrefix "tni" in
          the library's AssemblyInfo.cs and resolved by a real parse in TrayIconXamlContractTests. That is
          the snippet the README documents; this file cannot use it, because the element it declares is a
          type from its own project.

          x:Shared is deliberately left at its default (true): one key, one instance, one icon.
          x:Shared="False" would mint a new icon on every lookup.
        -->
        <local:SampleTrayIcon x:Key="TrayIcon"
                               Visible="True"
                               ToolTipText="Trustsoft.NotifyIcon sample (declared in XAML)"
                               MenuActivation="RightClick"
                               IconSource="{StaticResource TrayImage}"
                               ContextMenu="{StaticResource TrayMenu}"
                               TrayError="OnTrayError"
                               TrayLeftClick="OnClick"
                               TrayLeftDoubleClick="OnClick"
                               TrayRightClick="OnClick"
                               TrayMiddleClick="OnClick"
                               PreviewTrayLeftClick="OnPreviewClick"
                               PreviewTrayLeftDoubleClick="OnPreviewClick"
                               PreviewTrayRightClick="OnPreviewClick"
                               PreviewTrayMiddleClick="OnPreviewClick"
                               BalloonTipClicked="OnBalloonTipClicked"
                               PreviewBalloonTipClicked="OnPreviewBalloonTipClicked" />
    </Application.Resources>
</Application>
