<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The consumer's own feed configuration, and the reason the proof is a proof.

    <clear /> drops every source inherited from the repository root's NuGet.config and from the user
    and machine profiles, so this project cannot reach nuget.org even by accident. The only source
    left is the local folder the pack writes to, so a restore that succeeds here says the nupkg in
    artifacts/ is installable on its own - not that the build found something else, and not that it
    fell back to the project reference the in-repo sample uses.

    The path is relative to this file's directory (NuGet resolves packageSources values against the
    config that declares them), so it survives being copied anywhere the folder keeps its shape.
  -->
  <packageSources>
    <clear />
    <add key="artifacts-local-feed" value="../../artifacts" />
  </packageSources>
</configuration>
