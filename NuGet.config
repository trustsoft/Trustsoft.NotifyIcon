<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins NuGet's configuration source for this repository.

    Without a repository-level NuGet.config, restore depends on machine-wide and user-level
    config discovery. On this machine that discovery is broken: the solution-level restore graph
    calls NuGet.Common.NuGetEnvironment.CalculateFolderPath, which throws
    ArgumentNullException("path1") from Path.Combine while constructing
    XPlatMachineWideSetting, failing the whole solution restore with
    "error : Value cannot be null. (Parameter 'path1')" out of NuGet.targets.
    An explicit <clear/> plus the single nuget.org source makes restore deterministic and
    independent of that machine state (R011/D001: the product itself stays dependency-free;
    this file only describes where test-only packages come from).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
