<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins the package sources for this repository so restore does not depend on machine-wide or
    user-level NuGet configuration.

    Without a repository-level NuGet.config, discovery walks the user profile and the machine
    directories; on a developer box with a Visual Studio install that pulls in the offline
    package feed (C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.Offline.config) and
    whatever else the machine happens to have. Clearing the inherited sources makes the restore
    graph of this repository deterministic on every machine and in CI.

    This file only describes where test-only packages come from (R011, D001: the shipped
    Trustsoft.NotifyIcon library itself carries zero package references).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
